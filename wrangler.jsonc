{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gsc-ledger",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-31",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gsc-ledger-db",
      "database_id": "REPLACE_WITH_NEW_D1_DATABASE_UUID"
    }
  ]
}
